<mxfile host="app.diagrams.net" agent="ProblemHunt docs generator" version="24.7.0"><diagram id="arch" name="1. System architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style=&#x27;font-size:22px&#x27;&gt;&lt;b&gt;ProblemHunt.com — System Architecture&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Autonomous defense grid · 100% free &amp; open-source stack" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1700" height="50" as="geometry"/></mxCell><mxCell id="c3" value="① USERS &amp; DEVICES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=3;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="290" height="640" as="geometry"/></mxCell><mxCell id="c4" value="② FRONTEND — Next.js 14 static export&lt;br&gt;&lt;font style=&#x27;font-size:10px;font-weight:normal&#x27;&gt;React · Tailwind · Recharts · jsQR  (frontend/out)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f8f5;strokeColor=#2a9d8f;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=3;dashed=0;" vertex="1" parent="1"><mxGeometry x="360" y="80" width="330" height="640" as="geometry"/></mxCell><mxCell id="c5" value="③ BACKEND — Python FastAPI (backend/app) · runs with Uvicorn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6a700;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=3;dashed=0;" vertex="1" parent="1"><mxGeometry x="720" y="80" width="640" height="640" as="geometry"/></mxCell><mxCell id="c6" value="④ EXTERNAL SERVICES (all free)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6efff;strokeColor=#8e6cbf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=3;dashed=0;" vertex="1" parent="1"><mxGeometry x="1390" y="80" width="350" height="640" as="geometry"/></mxCell><mxCell id="c7" value="⑤ RUN &amp; DEPLOY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=3;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="1700" height="170" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Laptop / Desktop browser&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Chrome · Edge · Firefox&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="250" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Phone — installed PWA&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Add to Home Screen, no app store&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="250" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;User actions&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;paste link / SMS · scan QR · Lockdown&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="250" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;OS notifications&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;shown even when tab is closed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="250" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;CommandCenter UI&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Immunity gauge · Radar · Live feed · Charts · Rules · Nodes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5ee;strokeColor=#2a9d8f;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="290" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Scanner + jsQR&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;decodes QR from photo / live camera on-device&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5ee;strokeColor=#2a9d8f;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="380" y="220" width="290" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;lib/useDefenseGrid.ts&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;WebSocket client · auto-reconnect · REST polling fallback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5ee;strokeColor=#2a9d8f;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="380" y="310" width="290" height="60" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;lib/api.ts&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;REST client · admin-token prompt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5ee;strokeColor=#2a9d8f;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="380" y="400" width="290" height="55" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;lib/pwa.ts&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;SW register · Web Push subscribe · device detect&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5ee;strokeColor=#2a9d8f;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="380" y="480" width="290" height="55" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;public/sw.js — Service Worker&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27