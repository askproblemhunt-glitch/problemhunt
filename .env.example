# Copy to ".env" (same folder as start_problemhunt.py). Every setting is optional.

# ---- AI brain (pick ONE; all free) ----------------------------------------
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
# PH_GROQ_MODEL=llama-3.1-8b-instant
# Hugging Face token: https://huggingface.co/settings/tokens
# HUGGINGFACEHUB_API_TOKEN=
# Fully local & private: install https://ollama.com, run `ollama pull llama3.2`, then:
# PH_OLLAMA_MODEL=llama3.2

# ---- Admin account --------------------------------------------------------
# Locally, the FIRST account you create becomes the admin automatically.
# On a public server, set this; the account that signs up with this email becomes the admin.
# PH_ADMIN_EMAIL=you@example.com

# ---- Security (set these when you deploy publicly) -----------------------
# PH_ADMIN_TOKEN=change-me-to-a-long-random-string
# PH_CORS_ORIGINS=https://your-dashboard.vercel.app

# ---- Behaviour ------------------------------------------------------------
# PH_SIMULATION=0            # 1 = add simulated demo drills (default: real data only)
# PH_INTEL_FEEDS=1           # pull free OpenPhish + URLhaus feeds
# PH_PUSH_SIMULATED=1        # push alerts for critical drill events (throttled)
# PH_PUSH_MIN_INTERVAL=45

# ---- Optional cloud persistence (Supabase free tier) ---------------------
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
